# Copy to .env and fill in. See README.md for the quick-start walkthrough.

# Admin account: created on first boot, and its password is reset to
# MOG_ADMIN_PASSWORD on every start if the value changed (so a password
# changed from the UI is overwritten again while this stays set).
MOG_ADMIN_USERNAME=admin
MOG_ADMIN_PASSWORD=change-me

# Random secret; any long random string is fine.
AUTH_SECRET_KEY=change-me-too

# --- Metadata providers (optional, Phase 1 only supports these two) ---
# https://api-docs.igdb.com/#getting-started (Twitch developer account)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# https://www.steamgriddb.com/profile/preferences/api
STEAMGRIDDB_API_KEY=

# --- Install sandbox ---
INSTALL_SANDBOX_ENABLED=true
INSTALL_MAX_CONCURRENCY=1
INSTALL_TIMEOUT=3600
INSTALL_CACHE_DEFAULT_TTL_DAYS=7
# "cachyos-latest" or a GE-Proton tag (see GET /api/games/install/proton-builds).
INSTALL_DEFAULT_PROTON_BUILD=cachyos-latest
INSTALL_AUTO_STUCK_SECONDS=60

DEV_MODE=false
LOGLEVEL=INFO
